{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "threadlane-gpui",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value === 'threadlane-gpui' || @.name.value === 'threadlane-updater')].version"
        }
      ]
    }
  }
}
